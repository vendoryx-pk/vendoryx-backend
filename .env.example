# Copy to .env and fill real values (.env is gitignored)
VENDORYX_DB_URL=jdbc:postgresql://HOST/neondb?sslmode=require
VENDORYX_DB_USER=neondb_owner
VENDORYX_DB_PASSWORD=your_db_password
VENDORYX_JWT_SECRET=replace-with-at-least-32-character-secret
# Comma-separated; trailing slashes stripped. Never use *
VENDORYX_CORS_ORIGIN=https://vendoryx-frontend.pages.dev,http://localhost:4200
PORT=8080
